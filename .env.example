# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，绝不允许提交）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pc_doctor
DB_USERNAME=pcdoctor
DB_PASSWORD=change-me
# JWT 签名密钥：至少 32 字节随机串，生成方式 python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRATION_MINUTES=720
# 上传文件存储目录（生产环境填绝对路径，如 /var/pc-doctor/）
PC_UPLOAD_PATH=./upload/
# CORS 允许的前端来源（逗号分隔，可覆盖默认的 localhost:5173）
# CORS_ALLOWED_ORIGINS=https://pc-doctor.example.com,https://www.pc-doctor.example.com
# 管理员种子账号（Flyway V3 迁移时创建；未设置则跳过创建管理员）
# 注意：.env 按 properties 格式解析，请勿放置非 ASCII 值（中文默认值在 application.yml）
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me
